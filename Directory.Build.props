<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.0</Version>
    <Authors>Jozef Walterstein</Authors>
    <Company>Jozef Walterstein</Company>
    <Product>Hardening Checker</Product>
    <Copyright>Copyright (c) 2026 Jozef Walterstein</Copyright>
    <RepositoryUrl>https://github.com/JW-0042/win-hardening-checker</RepositoryUrl>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
