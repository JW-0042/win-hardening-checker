<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HardeningChecker.Core\HardeningChecker.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    
    
    
    <UseWPF>true</UseWPF>
    <AssemblyName>HardeningChecker</AssemblyName>
