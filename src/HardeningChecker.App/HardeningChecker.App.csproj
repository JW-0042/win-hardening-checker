    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- WPF Fluent theme (Application.ThemeMode) is still marked experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

</Project>
