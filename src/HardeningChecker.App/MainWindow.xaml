<Window x:Class="HardeningChecker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HardeningChecker.App"
        Title="Hardening Checker" Width="1240" Height="780" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- Left: score and actions -->
        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="Hardening Checker" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding MachineLine}" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,16" />

            <Border CornerRadius="10" Padding="16" Margin="0,0,0,12"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Security score" Opacity="0.7" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ScoreText}" FontSize="48" FontWeight="Bold" />
                        <TextBlock Text=" / 100" FontSize="18" Opacity="0.6" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                    </StackPanel>
                    <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Opacity="0.8" />
                </StackPanel>
            </Border>

            <Button Content="Scan this computer" Click="Scan_Click" IsEnabled="{Binding CanScan}"
                    Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="8,10" Margin="0,0,0,8" />
            <ProgressBar Maximum="{Binding CheckCount}" Value="{Binding Progress, Mode=OneWay}" Height="4" Margin="0,0,0,8"
                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />

            <Button Content="Restart as administrator" Click="Elevate_Click" HorizontalAlignment="Stretch" Padding="8,8" Margin="0,0,0,8"
                    Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisInverted}}" />
            <TextBlock Text="{Binding ElevationLine}" TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,0,0,16" />

            <TextBlock Text="Export" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Button Content="Save HTML report" Click="ExportHtml_Click" IsEnabled="{Binding HasReport}" HorizontalAlignment="Stretch" Padding="8,8" Margin="0,0,0,8" />
            <Button Content="Save JSON report" Click="ExportJson_Click" IsEnabled="{Binding HasReport}" HorizontalAlignment="Stretch" Padding="8,8" />

            <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="12" Margin="0,20,0,0"
                       Text="Read-only: this tool never changes settings. Fixes are shown as instructions you can review and apply yourself." />
        </StackPanel>

        <!-- Middle: list -->
        <DockPanel Grid.Column="1" Margin="0,0,16,0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                         ToolTip="Search by title, ID or category" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" />
            </Grid>
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="3" Background="{Binding Status, Converter={StaticResource StatusBrush}}" />
                            <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Opacity="0.65" FontSize="12">
                                    <Run Text="{Binding Id, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Category, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Severity, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="2" CornerRadius="10" Padding="10,2" VerticalAlignment="Center"
                                    Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                <TextBlock Text="{Binding StatusLabel}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Right: detail -->
        <Border Grid.Column="2" CornerRadius="10" Padding="18"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <TextBlock Text="Run a scan and pick a check to see the details." Opacity="0.6" TextWrapping="Wrap"
                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisInverted}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}"
                              Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Border CornerRadius="10" Padding="10,2" HorizontalAlignment="Left" Margin="0,0,0,8"
                                Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                            <TextBlock Text="{Binding StatusLabel}" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Opacity="0.65" Margin="0,2,0,12">
                            <Run Text="{Binding Id, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Category, Mode=OneWay}" /><Run Text=" · severity " /><Run Text="{Binding Severity, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Text="What we found" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Evidence, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,4,0,12" />

                        <TextBlock Text="What this checks" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,12" />

                        <TextBlock Text="Why it matters" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Rationale}" TextWrapping="Wrap" Margin="0,4,0,12" />

                        <TextBlock Text="How to fix" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Remediation}" TextWrapping="Wrap" Margin="0,4,0,8" />
                        <StackPanel Visibility="{Binding HasCommand, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <TextBox Text="{Binding RemediationCommand, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                            <Button Content="Copy command" Click="CopyCommand_Click" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,4" />
                            <TextBlock Text="Review the command before running it in an elevated PowerShell." Opacity="0.6" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Text="References" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding References}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2" TextWrapping="Wrap">
                                        <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="Link_RequestNavigate">
                                            <Run Text="{Binding Label, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
